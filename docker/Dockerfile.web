# Multi-stage Dockerfile for Angular Web UI
FROM node:22-alpine AS build
WORKDIR /app

COPY src/PDFStudio.Web/package*.json ./
RUN npm install

COPY src/PDFStudio.Web/ ./
RUN npm run build -- --configuration production

FROM nginx:1.27-alpine AS final
COPY --from=build /app/dist/pdf-studio-web /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

