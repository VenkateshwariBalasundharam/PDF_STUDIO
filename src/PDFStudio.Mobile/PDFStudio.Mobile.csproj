<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(BuildingForMobile)' == 'true'">net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildingForMobile)' != 'true'">net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PDFStudio.Mobile</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDFStudio.SDK\PDFStudio.SDK.csproj" />
    <ProjectReference Include="..\PDFStudio.Shared\PDFStudio.Shared.csproj" />
  </ItemGroup>

</Project>

