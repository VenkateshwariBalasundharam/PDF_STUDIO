<Window x:Class="PDFStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDFStudio Enterprise — Windows Desktop Workstation" Height="780" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PDFStudio" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,10,0"/>
                    <TextBlock Text="Enterprise PDF Generator &amp; Manipulation Studio" FontSize="15" VerticalAlignment="Center" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="Offline Processing Mode" IsChecked="{Binding IsOfflineMode}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Tabs (Bills & Invoices + Raw API) -->
            <TabControl Grid.Column="0" Background="#1E293B" BorderBrush="#334155">
                
                <!-- Tab 1: Bills & Invoices Generator -->
                <TabItem Header="⚡ Bills &amp; Invoices">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Company &amp; Invoice Details" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="#38BDF8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Company Name" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Company Address" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Invoice No" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Customer Name" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Watermark Section -->
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Background="#0F172A" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Content="Watermark pages with company name" IsChecked="{Binding EnableWatermark}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Watermark Text" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Opacity %" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding WatermarkOpacity, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Day-to-Day Update Graph & Analytics Section -->
                            <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Background="#0F172A" Padding="10" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox Content="Include Day-to-Day Update Graph &amp; Analytics" IsChecked="{Binding EnableChart}" Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,6,6" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Graph Type:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <ComboBox SelectedValue="{Binding ChartType}" SelectedValuePath="Tag" Background="#1E293B" Foreground="#F8FAFC">
                                                <ComboBoxItem Content="Stacked Bar (Day-to-Day)" Tag="stacked-bar" IsSelected="True" />
                                                <ComboBoxItem Content="Stacked Area (Volume Trend)" Tag="stacked-area" />
                                                <ComboBoxItem Content="Multi-Line (Trajectory)" Tag="multi-line" />
                                                <ComboBoxItem Content="Running Total (Cumulative)" Tag="cumulative" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Stack Breakdown:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                                            <ComboBox SelectedValue="{Binding ChartGrouping}" SelectedValuePath="Tag" Background="#1E293B" Foreground="#F8FAFC">
                                                <ComboBoxItem Content="by Customer" Tag="Customer" IsSelected="True" />
                                                <ComboBoxItem Content="by Product" Tag="Product" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Embeds a live vector day-to-day update graph showing trends and volume across billing dates." FontSize="10" Foreground="#64748B" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="⚡ Generate Invoice" Command="{Binding GenerateDesktopInvoiceCommand}" Margin="0,0,8,0" />
                                <Button Content="📊 Consolidated + Chart" Command="{Binding GenerateConsolidatedReportCommand}" Background="#0D9488" Margin="0,0,8,0" />
                                <Button Content="📂 Open PDF" Command="{Binding OpenLastPdfCommand}" Background="#475569" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Raw API & Template Testing -->
                <TabItem Header="🔧 API &amp; Templates">
                    <StackPanel Margin="12">
                        <TextBlock Text="API &amp; Service Configuration" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" Foreground="#F8FAFC" />

                        <TextBlock Text="Server Base URL" FontSize="11" Margin="0,4,0,3" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="API Key Secret" FontSize="11" Margin="0,4,0,3" Foreground="#94A3B8" />
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Template Key / ID" FontSize="11" Margin="0,4,0,3" Foreground="#94A3B8" />
                        <TextBox Text="{Binding TemplateId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="JSON Payload Data" FontSize="11" Margin="0,4,0,3" Foreground="#94A3B8" />
                        <TextBox Text="{Binding JsonData, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Generate via API" Command="{Binding GeneratePdfCommand}" Margin="0,0,10,0" />
                            <Button Content="Local Offline Watermark" Command="{Binding WatermarkPdfCommand}" Background="#475569" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

            </TabControl>

            <!-- Right Activity & Console Log Panel -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Activity Log &amp; Real-Time Diagnostics" FontWeight="Bold" FontSize="13" Margin="0,0,0,10" Foreground="#38BDF8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLogs}" Background="Transparent" BorderThickness="0" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <TextBlock Text="PDFStudio .NET 10 (LTS) Enterprise Client — Active on Web and Windows Desktop" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
